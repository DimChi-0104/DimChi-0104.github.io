# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채워 넣으세요.
# .env는 절대 커밋하지 마세요 (.gitignore에 이미 등록되어 있습니다).

# Spotify (https://developer.spotify.com/dashboard 에서 앱 생성)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Discord (https://discord.com/developers/applications 에서 봇 생성)
# 봇의 "Presence Intent"를 반드시 켜야 온라인 상태를 읽어올 수 있습니다.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# 서버 포트 (기본값 3000)
PORT=3000
